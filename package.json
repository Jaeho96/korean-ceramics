    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.9",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "pretendard": "1.3.9",
    "sharp": "0.35.5",
    "three": "0.187.0",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
