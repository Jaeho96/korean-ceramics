{
  "name": "web-trend-lab",
  "private": true,
  "type": "module",
  "description": "Awwwards 수상작에서 본 기법(WebGL2 · glTF/Draco · 스크롤 연출)을 직접 만든 에셋으로 다시 만들어 보는 개인 실험",
  "scripts": {
